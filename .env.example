# Copy this file to .env and fill in your own values.
# .env is gitignored - never commit real tokens.

# Pushbullet access token: https://www.pushbullet.com/#settings/account
PUSHBULLET_ACCESS_TOKEN=your_pushbullet_access_token_here

# TMDB API Read Access Token (v4 bearer token): https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=your_tmdb_read_access_token_here
